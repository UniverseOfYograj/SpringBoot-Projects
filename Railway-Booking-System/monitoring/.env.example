# =============================================================================
# Railora Monitoring Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#      cp monitoring/.env.example monitoring/.env
# 2. Replace all placeholder values below with strong, unique secrets.
# 3. Start the stack:
#      docker compose --env-file monitoring/.env -f monitoring/docker-compose.yml up -d
#
# SECURITY RULES:
# - NEVER commit the active .env file to Git.
# - Keep Prometheus and Grafana bound to localhost (127.0.0.1) only.
# =============================================================================

# --- Metrics Scrape Authentication ---
# Must match METRICS_USER and METRICS_PASSWORD in the Spring Boot backend
METRICS_USER=promuser
METRICS_PASSWORD=replace_with_secure_metrics_password_here

# --- Grafana Administrator Credentials ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_secure_grafana_password_here

# --- Prometheus TSDB Retention ---
PROMETHEUS_RETENTION=30d
