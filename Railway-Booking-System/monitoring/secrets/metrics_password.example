# Example Prometheus metrics scrape password file
# Copy this file to 'metrics_password' (same directory) and insert the exact
# password configured for METRICS_PASSWORD in your .env / backend configuration:
#
# PowerShell:
#   "your_secure_password" | Set-Content -Path "monitoring/secrets/metrics_password" -NoNewline
#
# Linux / macOS:
#   echo -n "your_secure_password" > monitoring/secrets/metrics_password
#   chmod 600 monitoring/secrets/metrics_password
#
# Note: Prometheus strips leading and trailing whitespace.
replace_with_secure_metrics_password_here
