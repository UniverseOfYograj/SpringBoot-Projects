# =============================================================================
# Railora Unified Production Environment Configuration (.env.example)
# Phase 17.2 — Unified Docker Compose Orchestration
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Replace all placeholder values below with secure, randomly generated secrets.
# 3. NEVER commit .env to version control (.env and .env.* are git-ignored).
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Project & Network Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=railora-prod

# Host port for React Single Page Application (via containerized Nginx reverse proxy).
# Defaults to 80 (standard HTTP). If port 80 is occupied by local host services
# (e.g., Windows IIS, Apache, Skype) or requires unprivileged binding, override:
# FRONTEND_PORT=8080 or FRONTEND_PORT=8000
FRONTEND_PORT=80

# Local host ports for monitoring (bound to 127.0.0.1 by default)
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# -----------------------------------------------------------------------------
# 2. PostgreSQL Relational Database
# -----------------------------------------------------------------------------
# Dedicated production database name (isolated from dev/test databases)
POSTGRES_DB=railway_booking_prod
POSTGRES_USER=railora_user
# MANDATORY: Generate a strong random password for production
POSTGRES_PASSWORD=replace_with_strong_database_password_min_16_chars

# -----------------------------------------------------------------------------
# 3. Redis High-Speed Cache & Tatkal Queue Store
# -----------------------------------------------------------------------------
# MANDATORY: Requirepass authentication for Redis 7
REDIS_PASSWORD=replace_with_strong_redis_password_min_16_chars

# Memory limit for Redis container (enforced with --maxmemory-policy noeviction).
# 'noeviction' ensures that active Tatkal queue states and user entry records
# are NEVER silently evicted or corrupted under memory pressure.
# When memory limit is reached:
# - Read operations continue normally.
# - Cache writes fail open (Spring Cache logs warning and queries PostgreSQL).
# - New Tatkal queue joins fail closed (clean error returned to caller).
REDIS_MAXMEMORY=512mb

# -----------------------------------------------------------------------------
# 4. JWT Authentication & Security Secrets
# -----------------------------------------------------------------------------
# MANDATORY: Minimum 256 bits (32 bytes) cryptographically secure secrets
# You can generate them with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_cryptographically_secure_access_secret_min_32_bytes
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_refresh_secret_min_32_bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated list of permitted web origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# -----------------------------------------------------------------------------
# 5. Core Business & Operations Policy
# -----------------------------------------------------------------------------
# Server-side flat booking fare in INR
RAILWAY_BASE_FARE=500.00

# Scheduled seat hold reaper background task
SEAT_HOLD_REAPER_ENABLED=true
SEAT_HOLD_REAPER_FIXED_DELAY_MS=30000
SEAT_HOLD_REAPER_INITIAL_DELAY_MS=10000
SEAT_HOLD_REAPER_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# 6. Observability, Metrics & Telemetry
# -----------------------------------------------------------------------------
# Dedicated Metrics Scrape Authentication (Phase 15C / Phase 17.2)
# Enables MetricsSecurityConfig HTTP Basic authentication for /actuator/prometheus
METRICS_SCRAPE_AUTH_ENABLED=true
METRICS_USER=promuser
# MANDATORY: Generate a strong random password for Actuator metrics scraping.
# This MUST match the password in 'monitoring/secrets/metrics_password'.
METRICS_PASSWORD=replace_with_strong_metrics_password_min_16_chars

# Path to the mounted Prometheus Basic Auth password file.
# Prometheus reads this file directly (password_file directive).
# To initialize locally, copy 'monitoring/secrets/metrics_password.example' to
# 'monitoring/secrets/metrics_password' and insert the exact METRICS_PASSWORD:
#   PowerShell: "your_password" | Set-Content -Path "monitoring/secrets/metrics_password" -NoNewline
#   Linux/macOS: echo -n "your_password" > monitoring/secrets/metrics_password && chmod 600 monitoring/secrets/metrics_password
METRICS_PASSWORD_FILE=./monitoring/secrets/metrics_password

# Grafana Administrator Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password_min_12_chars
PROMETHEUS_RETENTION=30d

# -----------------------------------------------------------------------------
# 7. Payment Gateways (Production Safe Defaults)
# -----------------------------------------------------------------------------
# Simulated and mock payments are strictly disabled in production
RAILWAY_PAYMENT_SIMULATED_ENABLED=false
RAILWAY_PAYMENT_MOCK_ENABLED=false

# Razorpay remains opt-in. Set to true only with verified merchant credentials
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 8. External Message Brokers (Optional)
# -----------------------------------------------------------------------------
# Kafka remains disabled by default. Transactional outbox stages to PostgreSQL
RAILWAY_OUTBOX_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
RAILWAY_OUTBOX_KAFKA_TOPIC=railora-booking-events

# -----------------------------------------------------------------------------
# 9. Third-Party Integrations (Optional)
# -----------------------------------------------------------------------------
RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=
